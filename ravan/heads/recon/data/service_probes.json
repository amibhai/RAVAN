[
  {"service": "http", "ports": [80, 8080, 8000, 8008, 8888, 81, 8081, 8082, 8180, 8090, 3000, 5000, 9000], "probe": "GET / HTTP/1.0\r\nHost: {target}\r\nUser-Agent: ravan-recon\r\n\r\n", "match": "Server: (?P<version>[^\\r\\n]+)"},
  {"service": "https", "ports": [443, 8443, 4443, 9443, 10443], "probe": "HEAD / HTTP/1.0\r\nHost: {target}\r\n\r\n", "match": "Server: (?P<version>[^\\r\\n]+)"},
  {"service": "ssh", "ports": [22, 2222, 22222, 2022], "probe": "", "match": "(?P<version>SSH-\\S+)"},
  {"service": "ftp", "ports": [21, 2121], "probe": "", "match": "220[- ](?P<version>[^\\r\\n]+)"},
  {"service": "smtp", "ports": [25, 587, 465, 2525], "probe": "EHLO ravan.local\r\n", "match": "220[- ](?P<version>[^\\r\\n]+)"},
  {"service": "pop3", "ports": [110, 995], "probe": "", "match": "\\+OK (?P<version>[^\\r\\n]+)"},
  {"service": "imap", "ports": [143, 993], "probe": "", "match": "\\* OK (?P<version>[^\\r\\n]+)"},
  {"service": "mysql", "ports": [3306], "probe": "", "match": "(?P<version>\\d+\\.\\d+\\.\\d+[^\\x00]*)"},
  {"service": "postgresql", "ports": [5432, 5433], "probe": "", "match": "(?P<version>PostgreSQL[^\\x00]+)"},
  {"service": "redis", "ports": [6379, 6380], "probe": "INFO server\r\n", "match": "redis_version:(?P<version>[^\\r\\n]+)"},
  {"service": "mongodb", "ports": [27017, 27018, 27019], "probe": "GET / HTTP/1.0\r\n\r\n", "match": "MongoDB[/ ](?P<version>[\\d\\.]+)"},
  {"service": "elasticsearch", "ports": [9200, 9300], "probe": "GET / HTTP/1.0\r\nHost: {target}\r\n\r\n", "match": "\"number\"\\s*:\\s*\"(?P<version>[\\d\\.]+)\""},
  {"service": "memcached", "ports": [11211], "probe": "version\r\n", "match": "VERSION (?P<version>[^\\r\\n]+)"},
  {"service": "telnet", "ports": [23], "probe": "", "match": "(?P<version>[^\\r\\n]{3,80})"},
  {"service": "smb", "ports": [139, 445], "probe": "", "match": "(?P<version>SMB|NTLM|Windows)"},
  {"service": "tomcat", "ports": [8080, 8009, 8443], "probe": "GET / HTTP/1.0\r\nHost: {target}\r\n\r\n", "match": "Apache Tomcat/(?P<version>[\\d\\.]+)"},
  {"service": "iis", "ports": [80, 443, 8080], "probe": "HEAD / HTTP/1.0\r\nHost: {target}\r\n\r\n", "match": "Microsoft-IIS/(?P<version>[\\d\\.]+)"},
  {"service": "jenkins", "ports": [8080, 8443, 50000], "probe": "GET / HTTP/1.0\r\nHost: {target}\r\n\r\n", "match": "X-Jenkins: (?P<version>[\\d\\.]+)"},
  {"service": "gitlab", "ports": [80, 443], "probe": "GET /users/sign_in HTTP/1.0\r\nHost: {target}\r\n\r\n", "match": "GitLab(?:EE)?[/ ](?P<version>[\\d\\.]+)"},
  {"service": "couchdb", "ports": [5984], "probe": "GET / HTTP/1.0\r\nHost: {target}\r\n\r\n", "match": "\"version\":\"(?P<version>[\\d\\.]+)\""},
  {"service": "docker", "ports": [2375, 2376], "probe": "GET /version HTTP/1.0\r\nHost: {target}\r\n\r\n", "match": "\"Version\":\"(?P<version>[^\"]+)\""},
  {"service": "kubernetes", "ports": [6443, 8080, 8443], "probe": "GET /version HTTP/1.0\r\nHost: {target}\r\n\r\n", "match": "\"gitVersion\":\\s*\"(?P<version>[^\"]+)\""},
  {"service": "rsync", "ports": [873], "probe": "", "match": "@RSYNCD: (?P<version>[^\\r\\n]+)"},
  {"service": "vnc", "ports": [5900, 5901, 5902], "probe": "", "match": "RFB (?P<version>[\\d\\.]+)"},
  {"service": "zookeeper", "ports": [2181, 2182], "probe": "stat\n", "match": "Zookeeper version: (?P<version>[^,\\n]+)"}
]
